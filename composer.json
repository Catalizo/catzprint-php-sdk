{
    "name": "catzprint/catzprint-php",
    "description": "Official PHP SDK for the CatzPrint cloud printing API: print receipts, PDFs and images, seal content, and verify webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "catzprint",
        "printing",
        "receipt",
        "escpos",
        "pdf",
        "webhooks",
        "api",
        "sdk"
    ],
    "homepage": "https://catzprint.com/docs",
    "authors": [
        {
            "name": "Catalizo",
            "email": "info@catalizo.com"
        }
    ],
    "support": {
        "docs": "https://catzprint.com/docs"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-sodium": "Required for sealed printing (\"sealed\": true): content is encrypted to CatzPrint's public key before it leaves your server."
    },
    "autoload": {
        "psr-4": {
            "CatzPrint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CatzPrint\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "phpunit": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
